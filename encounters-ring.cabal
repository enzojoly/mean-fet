cabal-version:      2.4
name:               encounters-ring
version:            0.2.0
synopsis:           First-passage and first-encounter statistics on rings and lattices
build-type:         Simple

common warnings
    ghc-options: -Wall -Wno-unused-imports -Wno-name-shadowing

library
    import:           warnings
    ghc-options:      -O2
    hs-source-dirs:   src
    default-language: Haskell2010
    exposed-modules:  Types
                    , Estimate
                    , Ring
                    , Distribution
                    , Defect
                    , Passage
                    , Encounter
                    , Lattice
                    , Absorbing
                    , Cells
                    , Serialise
                    , Simulate
                    , MonteCarlo
                    , Cli
    build-depends:    base            >=4.14 && <5
                    , vector
                    , hmatrix
                    , random          >=1.3
                    , containers
                    , parallel
                    , deepseq
                    , bytestring
                    , directory
                    , filepath

executable encounters
    import:           warnings
    hs-source-dirs:   app
    main-is:          Main.hs
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:    base
                    , encounters-ring
                    , vector
                    , hmatrix
                    , random          >=1.3


test-suite spec
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    other-modules:    UnitSpec
                    , PropertySpec
                    , RegressionSpec
                    , ConsistencySpec
                    , BoundarySpec
                    , EncounterSpec
                    , GridSpec
                    , ReferenceSpec
                    , EstimateSpec
                    , OracleSpec
                    , DefectSpec
                    , AbsorbingSpec
                    , CellsSpec
                    , PrimitiveSpec
                    , DecompositionSpec
    build-depends:    base
                    , encounters-ring
                    , vector
                    , hmatrix
                    , tasty
                    , tasty-hunit
                    , tasty-quickcheck
